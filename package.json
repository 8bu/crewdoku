{
  "name": "crewdoku",
  "private": true,
  "license": "AGPL-3.0-only",
  "version": "0.0.0",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "pnpm --filter @crewdoku/app dev",
    "dev:proto": "pnpm --filter @crewdoku/proto dev",
    "build": "turbo run build",
    "preview": "pnpm --filter @crewdoku/proto preview",
    "test": "turbo run test",
    "test:watch": "vitest",
    "lint": "turbo run lint",
    "typecheck": "turbo run lint",
    "clean": "rm -rf .turbo proto/dist proto/node_modules/.vite node_modules/.cache"
  },
  "devDependencies": {
    "turbo": "^2.1.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
