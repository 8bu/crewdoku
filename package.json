{
  "name": "crewdoku",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "pnpm --filter @crewdoku/app dev",
    "build": "turbo run build",
    "preview": "pnpm --filter @crewdoku/app preview",
    "test": "turbo run test",
    "test:watch": "vitest",
    "lint": "turbo run lint",
    "typecheck": "turbo run lint",
    "clean": "rm -rf .turbo app/dist packages/domain/dist app/node_modules/.vite node_modules/.cache",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "turbo": "^2.1.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "@changesets/cli": "^2.27.0"
  }
}
